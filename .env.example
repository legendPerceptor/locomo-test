# 对外暴露的宿主机端口；容器内固定监听 8000
EMBEDDING_PORT=8000

# 默认中文 embedding 模型；也可以改成 BAAI/bge-small-zh-v1.5 等本地/远程模型
EMBEDDING_MODEL=BAAI/bge-large-zh-v1.5

# 设置后启用认证；请改成你自己的随机 token
EMBEDDING_API_KEY=change-me-to-a-random-token

# 可选：设置embedding服务的容器名称，默认为locomo_embedding_service
# EMBEDDING_CONTAINER_NAME=CHOOSE_A_UNIQUE_NAME

# 可选：设置hugging face的access token
# HF_TOKEN=YOUR_HUGGING_FACE_TOKEN

# 可选：使用 HuggingFace 镜像站下载模型
# HF_ENDPOINT=https://hf-mirror.com
